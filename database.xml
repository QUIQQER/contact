<?xml version="1.0" encoding="UTF-8"?>
<database>

    <global>
        <table name="quiqqer_contact_forms">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="string" length="255">identifier</field>
            <field type="string" length="255">title</field>
            <field type="text">dataFields</field>
            <field type="string" length="255" nullable="true" default="null">projectName</field>
            <field type="string" length="255" nullable="true" default="null">projectLang</field>
            <field type="bigint" nullable="true" default="null">siteId</field>
            <index>identifier</index>
        </table>

        <table name="quiqqer_contact_requests">
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="bigint">formId</field>
            <field type="datetime">submitDate</field>
            <field type="text">submitData</field>
            <index>formId</index>
        </table>
    </global>

</database>
